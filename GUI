def run_in_thread():
    try:
        global flag
        global errorflag 
        errorflag=True
        flag =0
        ser2 = serial.Serial('COM3', 115200, timeout=1)
        while(1):
            if(flag):
                errorflag=True 
                line = ser2.readline()
                string_data = line.decode('utf-8')
                print(string_data)
                xDate, xTime, xNoOfS, xLat, xLong, xElev, xAccX, xAccY, xAccZ, xGyroX, xGyroY, xGyroZ, xMagX, xMagY, xMagZ = string_data.split(',')
                NofSat.set(xNoOfS), Lat.set(xLat), Long.set(xLong), Elev.set(xElev)
                AngVelX.set(xGyroX), AngVelY.set(xGyroY), AngVelZ.set(xGyroZ)
                AccX.set(xAccX),AccY.set(xAccY),AccZ.set(xAccZ)
                MFeildX.set(xMagX),MFeildY.set(xMagY),MFeildZ.set(xMagZ)
    except Exception as e:
        errorflag=False
        messagebox.showerror("Error","USB connection error. Please check device connection and restart.")
        show_main_menu()
            
# Function to show the main menu
def show_main_menu():
    main_frame.pack(fill="both", expand=True)
    gui_frame.pack_forget()
    global flag
    flag=False

# Function to show your existing GUI
def show_gui():
    global errorflag
    if(errorflag):
        main_frame.pack_forget()
        gui_frame.pack(fill="both", expand=True)
        global flag
        flag=True
    else:
        messagebox.showerror("Error","USB connection error. Please check device connection and restart.")
        show_main_menu()
        
